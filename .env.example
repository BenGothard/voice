# Copy to .env when you go live. The MVP demo needs NONE of these — it runs on mock data.
# Leave them empty for the browser demo.

# --- LLM (for production voice agent) ---
# Provider for the brain: OpenAI, Anthropic, etc.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Speech (for production phone calls) ---
# Real-time speech-to-text
# DEEPGRAM_API_KEY=
# Text-to-speech
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=

# --- Telephony (for production phone calls) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-domain.com/api/call/message

# --- TPA / Claims system (replace mockTpa.ts) ---
# Base URL for your claims admin system (HealthEdge, QicLink, etc.)
# TPA_API_BASE_URL=
# TPA_API_KEY=

# --- Server ---
# PORT=3000
# NODE_ENV=development
